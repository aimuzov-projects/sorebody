# Переменные бэкенда (контейнер api): лежат в /srv/wodcare/api.env, в репо не попадают.
# Без CHAT_ENABLED=1 и ключа чат выключен, /api/chat отвечает 404, MCP работает как обычно.
# Права на файл -- только владельцу: chmod 600 api.env.

CHAT_ENABLED=1
OPENROUTER_API_KEY=
# Модель в OpenRouter, по умолчанию anthropic/claude-opus-5.5:
# CHAT_MODEL=anthropic/claude-haiku-5.5
# Лимиты чата (src/backend/chat/http.ts, QUOTA), здесь -- значения по умолчанию:
# CHAT_PER_MINUTE=5
# CHAT_PER_DAY=12
# CHAT_DIALOGS_PER_DAY=40
# CHAT_DOLLARS_PER_DAY=1.5
# Откуда разрешены запросы к чату, через запятую:
# CHAT_ORIGINS=https://sorebody.aimuzov.online
