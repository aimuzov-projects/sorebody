---
import { BookOpen, ExternalLink, Rotate3d, Sparkles } from 'lucide-static'

import { IMAGE_HEIGHT, IMAGE_SIZES, IMAGE_WIDTH, imageSrcset } from '#frontend/lib/article-image.ts'
import { atlasSrc, atlasUrl, type Atlas } from '#frontend/lib/atlas.ts'
import { splitCaption } from '#frontend/lib/caption.ts'
import { posterUrls, rigUrl } from '#frontend/scene/model-url.ts'

type Props = {
	image: {
		src: string
		alt: string
		caption: string
		atlas?: Atlas
		model?: {
			name: string
			highlight: string[]
			show: string[]
			hide: string[]
			direction?: [number, number, number]
			still?: string
			note?: string
		}
	}
	/** Префикс id подсказок: на странице несколько иллюстраций. */
	id: string
}

const { image, id } = Astro.props
const caption = splitCaption(image.caption)
---

<figure class="article__figure">
	{/* Размеры заранее держат место под картинку, и текст не прыгает при загрузке. Телефон
	    берёт копию по своей ширине из srcset. Первая стоит в шапке статьи, её грузим сразу */}
	<div class="article__media">
		<img
			class:list={['article__image', image.src.endsWith('.webp') && 'article__image--cutout']}
			src={image.src}
			srcset={imageSrcset(image.src)}
			sizes={IMAGE_SIZES}
			alt={image.alt}
			width={IMAGE_WIDTH}
			height={IMAGE_HEIGHT}
			loading={id === 'figure-0' ? 'eager' : 'lazy'}
			decoding="async"
		/>
		{/* Кнопку показывает lib/figure-3d.ts, если браузер умеет WebGL; модель грузится только по ней */}
		{image.model && (
			<button
				class="article__model-open"
				type="button"
				hidden
				data-figure-3d={JSON.stringify({
					url: rigUrl(image.model.name),
					poster: posterUrls(image.src),
					highlight: image.model.highlight,
					show: image.model.show,
					hide: image.model.hide,
					direction: image.model.direction,
					still: image.model.still,
					note: image.model.note,
				})}
			>
				<span class="article__model-icon" aria-hidden="true" set:html={Rotate3d} />
				Покрутить в 3D
			</button>
		)}
	</div>
	{/* Подпись: заголовок рисунка и текст, под ними строкой чипы "атлас" и "от нейросети" */}
	<figcaption class="article__caption">
		{caption.title && <strong class="article__caption-title">{caption.title}:</strong>} {caption.text}
		{(image.atlas || caption.generated) && (
			<span class="article__notes">
				{image.atlas && (
					<>
						<button
							class="article__note"
							type="button"
							aria-controls={`${id}-atlas`}
							aria-expanded="false"
							data-tip-for={`${id}-atlas`}
						>
							<span class="article__note-icon" aria-hidden="true" set:html={BookOpen} />
							Сверено с атласом
						</button>
						<span class="tip tip--atlas" id={`${id}-atlas`} popover="auto">
							<img
								class="tip__plate"
								src={atlasSrc(image.atlas.file)}
								alt={`Таблица из «Анатомии Грея»: ${image.atlas.caption}`}
								loading="lazy"
							/>
							<span class="tip__plate-caption">
								{image.atlas.caption}. «Анатомия Грея», 1918, общественное достояние.
							</span>
							<a class="tip__plate-link" href={atlasUrl(image.atlas.file)} target="_blank" rel="noopener">
								Открыть в Wikimedia Commons
								<span class="tip__plate-icon" aria-hidden="true" set:html={ExternalLink} />
							</a>
						</span>
					</>
				)}
				{caption.generated && (
					<>
						<button
							class="article__note"
							type="button"
							aria-describedby={`${id}-ai`}
							aria-expanded="false"
							data-tip-for={`${id}-ai`}
						>
							<span class="article__note-icon" aria-hidden="true" set:html={Sparkles} />
							Схема, ИИ
						</button>
						<span class="tip" id={`${id}-ai`} popover="auto">
							Схематичная иллюстрация, сгенерирована нейросетью; анатомия упрощена
						</span>
					</>
				)}
			</span>
		)}
	</figcaption>
</figure>
