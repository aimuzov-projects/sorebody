---
// src/frontend/components/article-figure.astro
import { BookOpen, ExternalLink, Sparkles } from 'lucide-static'

import { atlasSrc, atlasUrl, type Atlas } from '#frontend/lib/atlas.ts'
import { splitCaption } from '#frontend/lib/caption.ts'

type Props = {
	image: { src: string; alt: string; caption: string; atlas?: Atlas }
	/** Префикс id подсказок: на странице несколько иллюстраций. */
	id: string
}

const { image, id } = Astro.props
const caption = splitCaption(image.caption)
---

<figure class="article__figure">
	<img
		class:list={['article__image', image.src.endsWith('.webp') && 'article__image--cutout']}
		src={image.src}
		alt={image.alt}
		width="1200"
		height="669"
		loading={id === 'figure-0' ? 'eager' : 'lazy'}
	/>
	{/* Подпись: заголовок рисунка, текст и чипы "от нейросети" и "атлас" */}
	<figcaption class="article__caption">
		{caption.title && <strong class="article__caption-title">{caption.title}:</strong>} {caption.text}
		{caption.generated && (
			<>
				<button
					class="article__note"
					type="button"
					aria-describedby={`${id}-ai`}
					aria-expanded="false"
					data-tip-for={`${id}-ai`}
				>
					<span class="article__note-icon" aria-hidden="true" set:html={Sparkles} />
					Схема, ИИ
				</button>
				<span class="tip" id={`${id}-ai`} popover="auto">
					Схематичная иллюстрация, сгенерирована нейросетью; анатомия упрощена
				</span>
			</>
		)}
		{image.atlas && (
			<>
				<button
					class="article__note"
					type="button"
					aria-controls={`${id}-atlas`}
					aria-expanded="false"
					data-tip-for={`${id}-atlas`}
				>
					<span class="article__note-icon" aria-hidden="true" set:html={BookOpen} />
					Сверено с атласом
				</button>
				<span class="tip tip--atlas" id={`${id}-atlas`} popover="auto">
					<img
						class="tip__plate"
						src={atlasSrc(image.atlas.file)}
						alt={`Таблица из «Анатомии Грея»: ${image.atlas.caption}`}
						loading="lazy"
					/>
					<span class="tip__plate-caption">
						{image.atlas.caption}. «Анатомия Грея», 1918, общественное достояние.
					</span>
					<a class="tip__plate-link" href={atlasUrl(image.atlas.file)} target="_blank" rel="noopener">
						Открыть в Wikimedia Commons
						<span class="tip__plate-icon" aria-hidden="true" set:html={ExternalLink} />
					</a>
				</span>
			</>
		)}
	</figcaption>
</figure>
