---
import { createHash } from 'node:crypto'

import {
	ArrowRight,
	ChevronDown,
	ChevronLeft,
	ChevronRight,
	ExternalLink,
	TextQuote,
	TriangleAlert,
} from 'lucide-static'

import { frequencyOf } from '#frontend/data/frequency.ts'
import { type ElementIcon, MOVEMENT_ICONS } from '#frontend/data/movement-icons.ts'
import { regionLabel } from '#frontend/data/regions.ts'
import {
	DEFAULT_SPORT,
	sportArticle,
	sportElement,
	sportHome,
	sportOf,
	type Sport,
	type SportSlug,
} from '#frontend/data/sports.ts'
import ArticleFigure from '#frontend/components/article-figure.astro'
import BarLead from '#frontend/components/bar-lead.svelte'
import SiteHeader from '#frontend/components/site-header.svelte'
import SportSwitch from '#frontend/components/sport-switch.svelte'
import TocMenu from '#frontend/components/toc-menu.astro'
import Base from '#frontend/layouts/base.astro'
import { enhanceArticle, INJURY_HEADINGS, LENS_HEADINGS, type ArticlePart } from '#frontend/lib/article-html.ts'
import { lensSports, type Injury, type Lens } from '#frontend/lib/catalog.ts'
import { injuryPage } from '#frontend/lib/injury-page.ts'
import { INFO_DOT } from '#frontend/lib/icons.ts'
import { sourceDetails } from '#frontend/lib/source-details.ts'
import { sourcesSummary } from '#frontend/lib/sources.ts'
import { SOURCES_PEEK } from '#frontend/lib/sources-peek.ts'
import { plural } from '#frontend/lib/plural.ts'
import { splitTitle } from '#frontend/lib/title.ts'
import '#frontend/styles/article.css'

/**
 * Лонгрид травмы. Со спортом и линзой -- статья спорта (`/<sport>/<slug>/`): общая часть и линза
 * в одном оглавлении. Без них -- общая страница (`/injuries/<slug>/`) со списком спортов `sports`.
 * `sports` -- спорты, где у травмы есть линза: на странице спорта из них селект «Разбор в …».
 */
type Props = {
	injury: Injury
	lens?: { sport: Sport; entry: Lens }
	sports?: SportSlug[]
}

const { injury, lens, sports = [] } = Astro.props
const { data } = injury
const sport = lens?.sport
const home = sport ? sportHome(sport.slug) : '/'
// Ссылки на травмы из текста -- сразу на страницу разбора, мимо переадресаций
const sportsByInjury = await lensSports()
const parts: ArticlePart[] = [{ kind: 'injury', html: injury.rendered?.html ?? '' }]

if (lens) parts.push({ kind: 'lens', html: lens.entry.rendered?.html ?? '' })

const { html, sections, sources } = enhanceArticle(parts, {
	sources: [...data.sources, ...(lens?.entry.data.sources ?? [])],
	sport,
	injuryHref: (slug) => injuryPage(slug, sportsByInjury.get(slug) ?? [], sport?.slug),
})
// Столько источников прячет свёрнутый список, их число -- на кнопке
const hiddenSources = Math.max(0, sources.length - SOURCES_PEEK)
const frequency = lens && frequencyOf(lens.entry.data.frequency)
const summary = lens?.entry.data.summary
const elements = sport ? sport.elements.filter((e) => lens.entry.data.elements.includes(e.slug)) : []
const [image, ...moreImages] = data.images
// Остальные иллюстрации -- в конце раздела "Что это", перед следующим разделом
const nextAt = html.indexOf('<section class="article-section', 1)
const [bodyHead, bodyTail] =
	moreImages.length > 0 && nextAt > 0 ? [html.slice(0, nextAt), html.slice(nextAt)] : [html, '']
// Другое название из скобок в конце -- не текстом в заголовке, а значком со всплывашкой
const { name, alias } = splitTitle(data.title)
const nameHead = name.slice(0, name.lastIndexOf(' ') + 1)
const nameTail = name.slice(nameHead.length)

/**
 * Общая страница травмы нескольких спортов: до неё здесь жила статья кроссфита, и старые ссылки
 * ведут к разделам, которых в общей части нет (`#adapt`, `#frequency`, `#mechanism`). Такой хеш
 * уводим к тому же разделу статьи кроссфита. Inline-скрипты Astro в CSP не хеширует, хеш считаем сами.
 */
const switchProps =
	sport && sports.length > 1
		? {
				sports: sports.map((slug) => ({
					slug,
					title: sportOf(slug).title,
					phrase: sportOf(slug).phrase,
					href: sportArticle(slug, injury.id),
				})),
				value: sport.slug,
				size: 'lead' as const,
			}
		: undefined

const lensOnly = LENS_HEADINGS.filter((h) => !INJURY_HEADINGS.some((i) => i.id === h.id)).map((h) => h.id)
const toLens =
	!sport && sports.includes(DEFAULT_SPORT)
		? `if(${JSON.stringify(lensOnly)}.includes(location.hash.slice(1)))location.replace(${JSON.stringify(sportArticle(DEFAULT_SPORT, injury.id))}+location.hash)`
		: undefined

if (toLens) Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(toLens).digest('base64')}`)
---

<Base
	title={sport ? `${data.title} ${sport.phrase}` : data.title}
	description={summary ?? `${data.title}: что это, симптомы, когда к врачу, диагностика и лечение.`}
	sport={sport?.slug}
>
	{toLens && <script is:inline slot="head" set:html={toLens} />}
	<div class="reading-progress" aria-hidden="true">
		<span class="reading-progress__bar"></span>
	</div>
	<SiteHeader>
		<a class="article-bar__back" href={home} aria-label="Назад" title="Назад" data-back set:html={ChevronLeft} />
		<BarLead title={name} {home} />
	</SiteHeader>
	<main class="article" data-article>
		<header class="article__hero">
			{/* Метки чипами, как фильтры раскрытой зоны: зона -- ссылка на её список, частота -- знаком в своём цвете */}
			<p class="article__meta">
				<a
					class="article__pill article__pill--link"
					href={`${home}?region=${data.region}`}
					title={`Вся боль в зоне «${regionLabel(data.region)}»`}
				>
					<span class="article__pill-label">Зона</span>
					{regionLabel(data.region)}
					<span class="article__pill-arrow" aria-hidden="true" set:html={ChevronRight} />
				</a>
				{frequency && (
					<span class:list={['article__pill', `article__pill--${frequency.slug}`]}>
						<span class="article__pill-icon" aria-hidden="true" set:html={frequency.icon} />
						{frequency.pill}
					</span>
				)}
			</p>
			<h1 class="article__title">
				{alias ? (
					<>
						{nameHead}
						{/* Значок склеен с последним словом: не уезжает один на новую строку */}
						<span class="article__title-tail">
							{nameTail}
							<button
								class="article__alias"
								type="button"
								aria-label={`Другие названия: ${alias}`}
								aria-expanded="false"
								aria-controls="article-alias"
								data-tip-for="article-alias"
								set:html={INFO_DOT}
							/>
						</span>
						<span class="tip" id="article-alias" popover="auto">
							Также называют: {alias}
						</span>
					</>
				) : (
					name
				)}
			</h1>
			{/* «Разбор ‹в кроссфите ▾›»: фраза спорта -- кнопка списка, как у фильтра движения на главной.
			   Спорт один -- простой текст. В статье поверх модели остров монтирует сама сцена по
			   data-sport-switch: острова во вставленном HTML не оживают */}
			{sport && (
				<div class="article__sport">
					<span aria-hidden={switchProps ? 'true' : undefined}>Разбор </span>
					{switchProps ? (
						<span data-sport-switch={JSON.stringify(switchProps)}>
							<SportSwitch client:load {...switchProps} />
						</span>
					) : (
						<span class="article__sport-phrase">{sport.phrase}</span>
					)}
				</div>
			)}
			{/* Без JS селект не уводит: разборы других спортов -- обычными ссылками */}
			{sport && sports.length > 1 && (
				<noscript>
					<p class="article__sport-links">
						Разбор и в других видах спорта:{' '}
						{sports
							.filter((slug) => slug !== sport.slug)
							.map((slug, i) => (
								<>
									{i > 0 && ', '}
									<a class="article__sport-link" href={sportArticle(slug, injury.id)}>
										{sportOf(slug).phrase}
									</a>
								</>
							))}
					</p>
				</noscript>
			)}
			{/* Коротко о травме: то же summary, что под названием в списках, но здесь -- главная мысль статьи */}
			{summary && (
				<div class="article__summary">
					<p class="article__summary-label">
						<span class="article__summary-icon" aria-hidden="true" set:html={TextQuote} />
						Коротко
					</p>
					<p class="article__summary-text">{summary}</p>
				</div>
			)}
			{/* Пометка в каждой статье, не только на /about: из поиска приходят сразу сюда. Значок -- тот же,
			   что у раздела «Когда сразу к врачу», куда ведёт ссылка */}
			<p class="article__disclaimer" role="note">
				<span class="article__disclaimer-icon" aria-hidden="true" set:html={TriangleAlert} />
				<span>
					<strong class="article__disclaimer-lead">Это справка, а не диагноз.</strong> С травмой — к врачу,
					тревожные признаки — в разделе{' '}
					<a class="article__disclaimer-link" href="#urgent">
						«Когда сразу к врачу»
					</a>
					.
				</span>
			</p>
			{image && <ArticleFigure {image} id="figure-0" />}
		</header>

		<div class="article__layout">
			<nav class="article__toc" aria-label="Разделы статьи" data-toc>
				<ol class="article__toc-list">
					{sections.map((section) => (
						<li>
							<a class="article__toc-link" href={`#${section.id}`}>
								<span class="article__toc-icon" aria-hidden="true" set:html={section.icon} />
								{section.title}
							</a>
						</li>
					))}
				</ol>
			</nav>

			<div class="article__body">
				<Fragment set:html={bodyHead} />
				{moreImages.map((more, i) => (
					<ArticleFigure image={more} id={`figure-${i + 1}`} />
				))}
				<Fragment set:html={bodyTail} />
			</div>
		</div>

		<footer class="article__end">
			{sport && elements.length > 0 && (
				<section class="article__related" aria-labelledby="related-title">
					<h2 class="article__end-title" id="related-title">
						{sport.elementsTitle}
					</h2>
					<ul class="article__chips">
						{elements.map((m) => (
							<li>
								<a class="article__chip" href={sportElement(sport.slug, m.slug)}>
									<span
										class="article__chip-icon"
										aria-hidden="true"
										set:html={MOVEMENT_ICONS[m.slug as ElementIcon] ?? ''}
									/>
									{m.title}
								</a>
							</li>
						))}
					</ul>
				</section>
			)}

			{/* Общая страница: частота, движения и адаптация тренировок -- в разборе по спорту */}
			{!sport && sports.length > 0 && (
				<section class="article__related" aria-labelledby="sports-title">
					<h2 class="article__end-title" id="sports-title">
						Разбор по видам спорта
					</h2>
					<ul class="article__chips">
						{sports.map((slug) => (
							<li>
								<a class="article__chip" href={sportArticle(slug, injury.id)}>
									<span class="article__chip-icon" aria-hidden="true" set:html={ArrowRight} />
									{sportOf(slug).title}
								</a>
							</li>
						))}
					</ul>
				</section>
			)}

			{/* Список длинный, а нужен не всем: виден первый источник с половиной второго, дальше --
			    фейд и кнопка. Сворачивает его скрипт (lib/sources-peek.ts), без JS список целиком */}
			<section class="article__sources" id="sources" aria-labelledby="sources-title" data-sources>
				<h2 class="article__end-title article__sources-title" id="sources-title">
					Источники <span class="article__sources-count">{sources.length}</span>
				</h2>
				<p class="article__sources-note">{sourcesSummary(sources)}</p>
				<ol class="article__source-list" id="sources-list">
					{sources.map((s) => {
						const { citation, type, links } = sourceDetails(s)

						return (
							<li class="article__source">
								<span class="article__source-label">{s.label}</span>
								{citation && (
									<span class="article__source-citation" lang="en">
										{citation}
									</span>
								)}
								<span class="article__source-links">
									{type && <span class="article__source-type">{type}</span>}
									{links.map((link) => (
										<a class="article__source-link" href={link.href} aria-label={link.ariaLabel}>
											{link.label}
											<span
												class="article__source-icon"
												aria-hidden="true"
												set:html={ExternalLink}
											/>
										</a>
									))}
								</span>
							</li>
						)
					})}
				</ol>
				<button class="article__sources-more" type="button" aria-controls="sources-list" hidden>
					Ещё {hiddenSources} {plural(hiddenSources, ['источник', 'источника', 'источников'])}
					<span class="article__sources-more-icon" aria-hidden="true" set:html={ChevronDown} />
				</button>
			</section>
		</footer>

		<TocMenu {sections} />
	</main>
</Base>

<script>
	import { initBackLink } from '#frontend/lib/back-link.ts'
	import { initReading } from '#frontend/lib/reading.ts'

	const root = document.querySelector('[data-article]')

	if (root) initReading(root, window, document.querySelector('.reading-progress__bar'))

	initBackLink()
</script>
