---
// src/frontend/components/injury-card.astro
import type { CollectionEntry } from 'astro:content'

import { Diamond } from 'lucide-static'

import { regionLabel } from '#frontend/data/regions.ts'

type Props = { entry: CollectionEntry<'injuries'> }

const { entry } = Astro.props
const { data } = entry
---

<a class="card" href={`/injuries/${entry.id}/`}>
	<span class="card__region">
		{regionLabel(data.region)}
		{data.frequency === 'rare' && (
			<span class="card__rare">
				· <span class="card__rare-icon" aria-hidden="true" set:html={Diamond} />
				редко
			</span>
		)}
	</span>
	<strong class="card__title">{data.title}</strong>
	<span class="card__summary">{data.summary}</span>
</a>

<style>
	.card {
		display: grid;
		gap: 6px;
		padding: 16px;
		border-radius: 12px;
		color: inherit;
		text-decoration: none;
		background: var(--surface);

		&:hover .card__title {
			color: var(--accent);
		}

		&__region,
		&__summary {
			font-size: 0.85rem;
			color: var(--muted);
		}

		/* Редкие -- тем же знаком и цветом, что в фильтре частоты на главной */
		&__rare {
			font-weight: 600;
			color: var(--rare);
		}

		&__rare-icon {
			display: inline-flex;
			width: 10px;
			height: 10px;

			/* stylelint-disable-next-line selector-max-type -- SVG из lucide-static приходит без класса */
			& :global(svg) {
				width: 100%;
				height: 100%;
				fill: currentcolor;
			}
		}
	}
</style>
