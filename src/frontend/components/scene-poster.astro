---
/**
 * Постер фигуры в серверном HTML: сцена (components/body-3d.svelte) `client:only`, и без него
 * место фигуры пустовало, пока грузится и запускается её JS. На широком экране он встаёт по CSS
 * (scene/poster-css.ts) туда же, где его поставила бы сцена. С монтированием сцена забирает этот
 * же элемент к себе и дальше ставит его сама, на телефоне -- впервые. Preload картинки --
 * components/poster-preload.astro, хеши в CSP ставит страница (POSTER_CSP).
 */
import { POSTER_CSS, POSTER_REVEAL } from '#frontend/scene/poster-css.ts'
---

<style is:inline set:html={POSTER_CSS}></style>
<picture class="body3d__poster" aria-hidden="true" hidden>
	<source srcset="/model/poster.webp" type="image/webp" />
	<img class="body3d__poster-image" src="/model/poster.png" alt="" />
</picture>
<script is:inline set:html={POSTER_REVEAL} />
<style>
	/* Окно постера -- всё окно, как у сцены (.body3d): `fixed` без отступов. В сцене он стоит
	   над канвасом и уходит с первым кадром модели */
	.body3d__poster {
		pointer-events: none;
		position: fixed;
		inset: 0;
		container-type: size;
		/* Фон сцены, пока её нет: иначе ореол за фигурой проявлялся бы вместе со сценой */
		background: radial-gradient(ellipse 60% 70% at 50% 45%, var(--a-glow) 0%, var(--a-bg) 70%);
	}

	/* В сцене фон её собственный, а постер лёг бы на канвас */
	.body3d__poster--placed {
		background: none;
	}

	.body3d__poster-image {
		position: absolute;
		max-width: none;
	}

	/* На телефоне место считает сцена по своей шторке: до неё постера нет */
	@container (width < 700px) {
		.body3d__poster:not(.body3d__poster--placed) .body3d__poster-image {
			display: none;
		}
	}
</style>
