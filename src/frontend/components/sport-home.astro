---
import Body3d from '#frontend/components/body-3d.svelte'
import Footer from '#frontend/components/footer.astro'
import PosterPreload from '#frontend/components/poster-preload.astro'
import ScenePoster from '#frontend/components/scene-poster.astro'
import { SPORTS, sportArticle, sportHome, type Sport } from '#frontend/data/sports.ts'
import Base from '#frontend/layouts/base.astro'
import { modelUrl } from '#frontend/scene/model-url.ts'
import { POSTER_CSP } from '#frontend/scene/poster-css.ts'
import { sceneData } from '#frontend/scene/scene-data.ts'
import '#frontend/styles/article.css'
import '#frontend/styles/scene.css'
// Меню разделов статьи поверх модели: разметка приходит со страницы статьи, стили -- отсюда
import '#frontend/styles/toc-menu.css'

/** Главная спорта: `/` у спорта по умолчанию и `/<sport>/` у каждого. */
type Props = { sport: Sport }

const { sport } = Astro.props

// meshopt-декодер модели -- WebAssembly; разрешаем его только на страницах с моделью
Astro.csp?.insertScriptResource("'wasm-unsafe-eval'")
// Inline-стиль и скрипт серверного постера (components/scene-poster.astro)
Astro.csp?.insertStyleHash(POSTER_CSP.style)
Astro.csp?.insertScriptHash(POSTER_CSP.script)

const { entries, zones, whole, movements, scene } = await sceneData(sport)
---

<Base
	title={scene.heading}
	description={sport.description}
	bare
	bodyClass="scene-page"
	sport={sport.slug}
	canonical={sportHome(sport.slug)}
	sportHomes={Object.fromEntries(SPORTS.map((s) => [s.slug, sportHome(s.slug)]))}
>
	<PosterPreload slot="head" />
	<!-- Подвал сайта внутри индекса -- ориентир страницы, поэтому и остальное содержимое в main -->
	<main>
		<h1 class="scene-page__title">{scene.heading}</h1>
		<ScenePoster />
		<Body3d client:only="svelte" {zones} {whole} {movements} sport={scene} modelUrl={modelUrl()}>
			<Footer slot="footer" />
		</Body3d>
	</main>
	<noscript>
		<ul class="scene-page__fallback">
			{[...entries]
				.sort((a, b) => a.injury.data.title.localeCompare(b.injury.data.title, 'ru'))
				.map(({ slug, injury }) => (
					<li>
						<a href={sportArticle(sport.slug, slug)}>{injury.data.title}</a>
					</li>
				))}
		</ul>
	</noscript>
</Base>
