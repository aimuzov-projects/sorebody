---
import { TableOfContents } from 'lucide-static'

import '#frontend/styles/toc-menu.css'

/** Разделы статьи из lib/article-html.ts или свои, как у /changelog. */
type Props = { sections: { id: string; title: string; icon: string }[]; label?: string }

const { sections, label = 'Разделы статьи' } = Astro.props
---

{/* Оглавление для узкого экрана, где боковое скрыто: круглая кнопка справа снизу и меню над
    ней. Esc, тап мимо и возврат фокуса на кнопку -- от popover="auto", подсветку раздела и
    плавный переход берёт на себя lib/reading.ts по data-toc, закрытие по пункту -- lib/toc-menu.ts */}
<div class="toc-menu" data-toc-menu>
	<button
		class="toc-menu__button"
		type="button"
		aria-label={label}
		aria-expanded="false"
		aria-controls="toc-menu"
		popovertarget="toc-menu"
	>
		<span class="toc-menu__button-icon" aria-hidden="true" set:html={TableOfContents} />
	</button>
	<nav class="toc-menu__panel" id="toc-menu" popover="auto" aria-label={label} data-toc>
		<ol class="toc-menu__list">
			{sections.map((section) => (
				<li>
					<a class="toc-menu__link" href={`#${section.id}`}>
						<span class="toc-menu__icon" aria-hidden="true" set:html={section.icon} />
						{section.title}
					</a>
				</li>
			))}
		</ol>
	</nav>
</div>
