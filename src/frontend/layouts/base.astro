---
import { createHash } from 'node:crypto'

import ChangelogLink from '#frontend/components/changelog-link.astro'
import Footer from '#frontend/components/footer.astro'
import ThemeToggle from '#frontend/components/theme-toggle.astro'
import '#frontend/styles/global.css'
import ThemeBoot from '@aimuzov-projects/infra-site-kit/theme-boot.astro'
import '@aimuzov-projects/infra-site-kit/theme-peek.css'
import { site } from '#frontend/data/site.ts'
import type { SportSlug } from '#frontend/data/sports.ts'
import { THEME_KEY } from '#frontend/lib/theme.ts'
import { pageTitle } from '#frontend/lib/title.ts'

type Props = {
	/** Название страницы, к нему добавится название сайта. У главной не задаётся. */
	title?: string
	/** `meta description` и `og:description`, по умолчанию `site.description`. */
	description?: string
	/** `false` у служебных страниц вроде 404: без canonical и с запретом индексации. */
	index?: boolean
	/** Страница на весь экран без подвала, как главная с 3D-моделью. */
	bare?: boolean
	/** Класс на `<body>`: полноэкранной странице нужно задать фон и токены всему документу. */
	bodyClass?: string
	/** Спорт страницы: `<html data-sport>` красит акцент его цветом (styles/global.css). */
	sport?: SportSlug
	/** Адрес canonical, если страница -- копия другой, по умолчанию своя. */
	canonical?: string
}

const { title, description = site.description, index = true, bare = false, bodyClass, sport } = Astro.props

/**
 * Mini App Telegram помечаем на `<html>` до отрисовки, чтобы свои кнопки «Назад» не мигали.
 * Признаки те же, что в lib/telegram.ts: хеш от Telegram или флаг в sessionStorage.
 * Inline-скрипты Astro в CSP не хеширует, поэтому хеш считаем сами.
 */
const TELEGRAM_FLAG =
	"try{if(/tgWebApp(Data|Platform)=/.test(location.hash)||sessionStorage.getItem('wodcare:tg'))" +
	"document.documentElement.dataset.telegram=''}catch{if(/tgWebApp(Data|Platform)=/.test(location.hash))" +
	"document.documentElement.dataset.telegram=''}"

Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(TELEGRAM_FLAG).digest('base64')}`)

const fullTitle = pageTitle(title)
const canonical = new URL(Astro.props.canonical ?? Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="ru" data-sport={sport}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{index ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:locale" content="ru_RU" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<script is:inline set:html={TELEGRAM_FLAG} />
		<ThemeBoot key={THEME_KEY} />
		<slot name="head" />
	</head>
	<body class={bodyClass}>
		<ChangelogLink />
		<ThemeToggle />
		<slot />
		{!bare && <Footer />}
		<script>
			import '#frontend/lib/telegram.ts'
			import { initThemeToggle } from '#frontend/lib/theme.ts'

			initThemeToggle()
		</script>
	</body>
</html>
