---
import { createHash } from 'node:crypto'

/**
 * Страница-переадресация для старых адресов статического сайта: nginx про спорты не знает.
 * Скрипт уводит сразу и сохраняет `?region=` и хеш (раздел статьи, зону сцены), `<meta refresh>` --
 * запасной путь без JS. Canonical -- новый адрес, чтобы поисковик переклеил ссылку.
 */
type Props = { to: string }

const { to } = Astro.props
const GO = `location.replace(${JSON.stringify(to)}+location.search+location.hash)`

Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(GO).digest('base64')}`)
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<title>Переадресация</title>
		<meta name="robots" content="noindex" />
		<link rel="canonical" href={new URL(to, Astro.site)} />
		<script is:inline set:html={GO} />
		<meta http-equiv="refresh" content={`0;url=${to}`} />
	</head>
	<body>
		<a href={to}>Страница переехала</a>
	</body>
</html>
