---
import InjuryArticle from '#frontend/components/injury-article.astro'
import { SPORTS } from '#frontend/data/sports.ts'
import { sportInjuries } from '#frontend/lib/catalog.ts'

export async function getStaticPaths() {
	const paths = await Promise.all(
		SPORTS.map(async (sport) => {
			const entries = await sportInjuries(sport)
			const injuries = new Set(entries.map((e) => e.slug))

			return entries.map(({ slug, injury, lens }) => ({
				params: { sport: sport.slug, injury: slug },
				props: { injury, lens: { sport, entry: lens, injuries } },
			}))
		}),
	)

	return paths.flat()
}
---

<InjuryArticle {...Astro.props} />
