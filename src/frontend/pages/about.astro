---
import { BookOpen, ChevronLeft, FlaskConical, PersonStanding, Sparkles, Stethoscope } from 'lucide-static'

import BarLead from '#frontend/components/bar-lead.svelte'
import SiteHeader from '#frontend/components/site-header.svelte'
import Base from '#frontend/layouts/base.astro'
import { pubmedUrl } from '#frontend/lib/pubmed.ts'
import '#frontend/styles/article.css'

const title = 'О справочнике'

/** Разделы для оглавления сбоку: та же разметка, что строит lib/article-html.ts у статей. */
const SECTIONS = [
	{ id: 'method', title: 'Методика', icon: FlaskConical },
	{ id: 'numbers', title: 'Откуда цифры', icon: BookOpen },
	{ id: 'ai', title: 'Тексты и иллюстрации', icon: Sparkles },
	{ id: 'model', title: '3D-модель', icon: PersonStanding },
	{ id: 'doctor', title: 'Это не консультация', icon: Stethoscope },
]
const section = Object.fromEntries(SECTIONS.map((s) => [s.id, s]))
---

<Base {title} description="Как собран Sorebody: источники, методика и ограничения.">
	<div class="reading-progress" aria-hidden="true">
		<span class="reading-progress__bar"></span>
	</div>
	<SiteHeader>
		<a class="article-bar__back" href="/" aria-label="Назад" data-hint="Назад" data-back set:html={ChevronLeft} />
		<BarLead {title} home="/" />
	</SiteHeader>
	<main class="article" data-article>
		<header class="article__hero">
			<h1 class="article__title">{title}</h1>
			<p class="article__lead">
				Как собран Sorebody: откуда взяты темы и цифры, кто писал тексты и рисовал иллюстрации и чего справка
				не умеет.
			</p>
		</header>

		<div class="article__layout">
			<nav class="article__toc" aria-label="Разделы страницы" data-toc>
				<ol class="article__toc-list">
					{SECTIONS.map((s) => (
						<li>
							<a class="article__toc-link" href={`#${s.id}`}>
								<span class="article__toc-icon" aria-hidden="true" set:html={s.icon} />
								{s.title}
							</a>
						</li>
					))}
				</ol>
			</nav>

			<div class="article__body">
				<section class="article-section" id="method" aria-labelledby="method-title">
					<h2 class="article-section__title" id="method-title">
						<span class="article-section__icon" aria-hidden="true" set:html={section.method.icon} />
						{section.method.title}
					</h2>
					<p>
						Что болит в каждом виде спорта, собрано по систематическим обзорам и исследованиям травматизма
						в нём, найденным на PubMed.
					</p>
					<p>
						В кроссфите и функциональном тренинге высокой интенсивности главный ориентир — метаанализ{' '}
						<a href={pubmedUrl('35278328')}>Knapik 2022</a>: 28 исследований, 11 089 человек, в среднем
						4,3 травмы на 1000 часов тренировок. В пяти проспективных исследованиях, где травмы отслеживали
						по ходу тренировок, частота выше — 9,9 на 1000 часов. Авторы считают, что проспективные
						исследования, вероятно, точнее учитывают травмы, поэтому общая оценка может быть занижена.
					</p>
					<p>
						В паделе — систематический обзор <a href={pubmedUrl('37337550')}>Dahmen 2023</a>:
						8 исследований, 2 022 человека, 3 травмы на 1000 часов игры. Литература по паделу молодая
						и почти целиком из анкет, проспективных исследований пока нет, поэтому оценки там ещё грубее.
					</p>
					<p>
						В футболе — метаанализ <a href={pubmedUrl('31171515')}>López-Valenciano 2020</a>:
						44 исследования профессионалов, 8,1 травмы на 1000 часов, а в матчах почти в 10 раз больше, чем
						на тренировках. Доли отдельных диагнозов — из исследования клубов УЕФА{' '}
						<a href={pubmedUrl('31182429')}>Ekstrand 2020</a>, где за 16 сезонов учтено почти 23 тысячи
						травм. Это в основном мужчины-профессионалы, по женщинам и любителям данных меньше.
					</p>
					<p>
						В беге — метаанализ <a href={pubmedUrl('25951917')}>Videbæk 2015</a>: у начинающих 17,8 травмы
						на 1000 часов бега, у бегающих давно — 7,7. Доли отдельных диагнозов — из систематического
						обзора <a href={pubmedUrl('33862272')}>Kakouris 2021</a>, где сведены проспективные исследования
						бегунов. Единого регистра травм, как у клубов УЕФА в футболе, у бега нет, а определения травмы
						в исследованиях разные.
					</p>
					<p>
						Статьи устроены одинаково: что это за боль, как её узнать, когда сразу идти к врачу и что делать
						в первые дни, к какому врачу идти, как ставят диагноз и лечат. Это общая часть, одна для всех
						видов спорта. К ней в каждом спорте свой разбор: как часто эта боль бывает именно там, на каких
						движениях или ударах, когда обычно возвращаются к тренировкам, как их адаптировать и как
						не допустить её снова.
					</p>
				</section>

				<section class="article-section" id="numbers" aria-labelledby="numbers-title">
					<h2 class="article-section__title" id="numbers-title">
						<span class="article-section__icon" aria-hidden="true" set:html={section.numbers.icon} />
						{section.numbers.title}
					</h2>
					<p>
						Цифры взяты из аннотаций статей. Большинство исследований — ретроспективные опросы, поэтому
						оценки частоты сильно расходятся, и к ним стоит относиться как к порядку величины.
					</p>
					<p>
						Поэтому частоту мы показываем не процентом, а уровнем. Частые — боль в зонах, на которые
						приходится больше всего травм в этом спорте (в кроссфите — плечо, поясница, колено), и диагнозы
						с прямыми данными по нему. В футболе диагнозы посчитаны напрямую, и частые там — те, на которые
						приходится 3% травм и больше, в беге — 5% и больше в проспективных исследованиях обзора и ещё
						в одной сводке исследований. Редкие в беге — те, что считают только медпункты забегов, анализы
						на финише и описания случаев. Нечастые — боль с небольшой долей или без отдельной статистики.
						Редкие — известные только по описаниям случаев. В списках на главной боль идёт от частой
						к редкой.
					</p>
					<p>
						У каждой цифры в статье есть сноска: номер ведёт к источнику. Почти всегда это исследование
						на PubMed, иногда клиническая рекомендация, например NICE. Полный список — в конце статьи.
					</p>
				</section>

				<section class="article-section" id="ai" aria-labelledby="ai-title">
					<h2 class="article-section__title" id="ai-title">
						<span class="article-section__icon" aria-hidden="true" set:html={section.ai.icon} />
						{section.ai.title}
					</h2>
					<p>
						Тексты написаны с помощью ИИ. В октябре 2026 года каждую цифру из исследования сверили с его
						аннотацией на PubMed или открытым полным текстом, а цифры из рекомендаций — с их текстом. Врач
						статьи пока не проверял: все они помечены как черновики.
					</p>
					<p>
						Иллюстрации сгенерированы нейросетью Nano Banana и сверены с таблицами «Анатомии Грея» (1918,
						общественное достояние): под такой картинкой есть чип «Сверено с атласом», он открывает таблицу.
						Это всё равно схемы: анатомия на них упрощена и может содержать неточности.
					</p>
				</section>

				<section class="article-section" id="model" aria-labelledby="model-title">
					<h2 class="article-section__title" id="model-title">
						<span class="article-section__icon" aria-hidden="true" set:html={section.model.icon} />
						{section.model.title}
					</h2>
					<p>
						Фигура на <a href="/">главной</a> и на страницах движений и ударов собрана из{' '}
						<a href="https://dbarchive.biosciencedbc.jp/en/bodyparts3d/desc.html">BodyParts3D</a>, © The
						Database Center for Life Science, лицензия{' '}
						<a href="https://creativecommons.org/licenses/by-sa/2.1/jp/deed.en">CC BY-SA 2.1 JP</a>.
						Мы упростили и сжали модель, изменённая версия распространяется на тех же условиях.
					</p>
					<p>
						Связки, мениски, суставные губы, нервы и мышцы, которых нет в BodyParts3D (широчайшая, мышцы
						поясницы и живота), взяты из{' '}
						<a href="https://github.com/Z-Anatomy/Models-of-human-anatomy">Z-Anatomy</a>, © Gauthier Kervyn,
						лицензия <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.ru">CC BY-SA 4.0</a>:
						мы перенесли их на кости BodyParts3D и тоже упростили.
					</p>
				</section>

				<section class="article-section article-section--urgent" id="doctor" aria-labelledby="doctor-title">
					<h2 class="article-section__title" id="doctor-title">
						<span class="article-section__icon" aria-hidden="true" set:html={section.doctor.icon} />
						{section.doctor.title}
					</h2>
					<p>
						Справка не заменяет консультацию врача. Sorebody — не медицинское изделие: он не ставит диагнозы
						и не назначает лечение, а помогает понять, что могло случиться и к кому идти.
					</p>
					<p>
						Если болит, не проходит или есть признаки из раздела «Когда сразу к врачу», покажитесь
						травматологу или спортивному врачу. Иллюстрации сгенерированы нейросетью, анатомия на них
						упрощена.
					</p>
					<p>
						Посещения сайт считает Яндекс Метрикой. Статистика обезличена, а то, что вы вводите в поиск,
						в записи Метрики не попадает.
					</p>
				</section>
			</div>
		</div>
	</main>
</Base>

<script>
	import { initBackLink } from '#frontend/lib/back-link.ts'
	import { initReading } from '#frontend/lib/reading.ts'

	const root = document.querySelector('[data-article]')

	if (root) initReading(root, window, document.querySelector('.reading-progress__bar'))

	initBackLink()
</script>
