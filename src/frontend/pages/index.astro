---
import Base from '#frontend/layouts/base.astro'
import { site } from '#frontend/data/site.ts'
---

<Base>
	<main class="home">
		<div class="container">
			<h1 class="home__title">{site.name}</h1>
			<p class="home__lead">{site.description}</p>
		</div>
	</main>
</Base>

<style>
	.home {
		padding-block: var(--section-y);

		&__title {
			font-size: clamp(2.4rem, 6vw, 3.6rem);
		}

		&__lead {
			max-width: 60ch;
			color: var(--muted);
		}
	}
</style>
