---
import { getCollection } from 'astro:content'

import InjuryArticle from '#frontend/components/injury-article.astro'
import { sportArticle } from '#frontend/data/sports.ts'
import Redirect from '#frontend/layouts/redirect.astro'
import { sportsOf } from '#frontend/lib/catalog.ts'

/**
 * Общая страница травмы: общая часть и спорты, где у неё есть разбор. Пока спорт у травмы один,
 * читателю нужен его разбор, а не выбор из одного пункта: адрес, по которому раньше жила статья
 * кроссфита, ведёт туда же, где она теперь.
 */
export async function getStaticPaths() {
	const injuries = await getCollection('injuries')

	return Promise.all(
		injuries.map(async (injury) => ({
			params: { slug: injury.id },
			props: { injury, sports: await sportsOf(injury.id) },
		})),
	)
}

const { injury, sports } = Astro.props
const [only] = sports
---

{sports.length === 1 && only ? <Redirect to={sportArticle(only, injury.id)} /> : <InjuryArticle {injury} {sports} />}
