---
import { getCollection } from 'astro:content'

import Body3d from '#frontend/components/lab/body-3d.svelte'
import { site } from '#frontend/data/site.ts'
import '#frontend/styles/global.css'
import { buildZones } from '#frontend/lab/zones.ts'
import { pageTitle } from '#frontend/lib/title.ts'

// Эксперимент: сцена на весь экран, поэтому без общего макета с подвалом.
// meshopt-декодер модели -- WebAssembly, общей CSP сайта он не нужен
Astro.csp?.insertScriptResource("'wasm-unsafe-eval'")

const injuries = (await getCollection('injuries')).map(({ id, data }) => ({
	slug: id,
	title: data.title,
	summary: data.summary,
	rare: data.frequency === 'rare',
	region: data.region,
}))
const { zones, whole } = buildZones(injuries)
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{pageTitle('3D-фигура (эксперимент)')}</title>
		<meta name="description" content={site.description} />
		<meta name="robots" content="noindex" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	</head>
	<body class="lab">
		<h1 class="lab__title">{site.name}: где болит?</h1>
		<Body3d client:only="svelte" {zones} {whole} modelUrl="/lab/body.glb" />
		<noscript>
			<ul>
				{injuries.map((injury) => (
					<li>
						<a href={`/injuries/${injury.slug}/`}>{injury.title}</a>
					</li>
				))}
			</ul>
		</noscript>
	</body>
</html>

<style>
	/* Визуальный язык страниц Apple: системный шрифт, нейтральная палитра, синий акцент.
	   Токены на body, потому что панель статьи живёт рядом со сценой, а не внутри неё */
	.lab {
		--a-font: -apple-system, blinkmacsystemfont, 'SF Pro Display', 'SF Pro Text', system-ui, sans-serif;
		--a-ease: cubic-bezier(0.25, 1, 0.5, 1);
		--a-bg: #f5f5f7;
		--a-page: #ffffff;
		--a-glow: #ffffff;
		--a-fg: #1d1d1f;
		--a-fg2: #6e6e73;
		--a-blue: #0071e3;
		--a-red: #ff3b30;
		--a-sep: rgb(0 0 0 / 8%);
		--a-fill: rgb(0 0 0 / 5%);
		--a-vibrancy: rgb(255 255 255 / 72%);
		--a-group: rgb(255 255 255 / 80%);
		--a-shadow: 0 8px 40px rgb(0 0 0 / 8%);

		/* Общие токены сайта, которыми пользуется вставленная статья */
		--fg: var(--a-fg);
		--muted: var(--a-fg2);
		--accent: var(--a-blue);
		--surface: var(--a-fill);
		--danger: var(--a-red);

		overflow: hidden;
		height: 100dvh;
		font-family: var(--a-font);
		font-size: 17px;
		line-height: 1.47;
		color: var(--a-fg);
		letter-spacing: -0.022em;
		color-scheme: light dark;
		background: var(--a-bg);

		@media (prefers-color-scheme: dark) {
			--a-bg: #000000;
			--a-page: #000000;
			--a-glow: #1d1d1f;
			--a-fg: #f5f5f7;
			--a-fg2: #a1a1a6;
			--a-blue: #2997ff;
			--a-red: #ff453a;
			--a-sep: rgb(255 255 255 / 12%);
			--a-fill: rgb(255 255 255 / 10%);
			--a-vibrancy: rgb(29 29 31 / 72%);
			--a-group: rgb(44 44 46 / 72%);
			--a-shadow: 0 8px 40px rgb(0 0 0 / 50%);
		}

		&__title {
			position: absolute;
			overflow: hidden;
			width: 1px;
			height: 1px;
			white-space: nowrap;
			clip-path: inset(50%);
		}
	}
</style>
