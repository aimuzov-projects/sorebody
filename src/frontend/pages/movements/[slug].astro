---
import { sportElement, sportOf } from '#frontend/data/sports.ts'
import Redirect from '#frontend/layouts/redirect.astro'

// Движения были только у кроссфита: старый адрес ведёт на его страницу элемента
export function getStaticPaths() {
	return sportOf('crossfit').elements.map((element) => ({ params: { slug: element.slug } }))
}
---

<Redirect to={sportElement('crossfit', Astro.params.slug)} />
