---
// src/frontend/pages/movements/[slug].astro
import { getCollection } from 'astro:content'

import InjuryCard from '#frontend/components/injury-card.astro'
import { MOVEMENTS } from '#frontend/data/movements.ts'
import Base from '#frontend/layouts/base.astro'

export async function getStaticPaths() {
	const injuries = await getCollection('injuries')

	return MOVEMENTS.map((movement) => ({
		params: { slug: movement.slug },
		props: { movement, injuries: injuries.filter((i) => (i.data.movements as string[]).includes(movement.slug)) },
	}))
}

const { movement, injuries } = Astro.props
---

<Base
	title={movement.title}
	index={injuries.length > 0}
	description={`Какие травмы случаются на движении «${movement.title}» и как их избежать.`}
>
	<main class="movement container">
		<p>
			<a href="/">Все травмы</a>
		</p>
		<h1>{movement.title}</h1>
		<p class="movement__en" lang="en">
			{movement.titleEn}
		</p>
		{injuries.length > 0 ? (
			<div class="movement__grid">
				{injuries.map((entry) => (
					<InjuryCard entry={entry} />
				))}
			</div>
		) : (
			<p>Статей про это движение пока нет.</p>
		)}
	</main>
</Base>

<style>
	.movement {
		padding-block: var(--section-y);

		&__en {
			color: var(--muted);
		}

		&__grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
			gap: 12px;
		}
	}
</style>
